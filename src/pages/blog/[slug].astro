---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime } from '../../lib/site';

export async function getStaticPaths() {
	const articles = await getCollection('blog');
	return articles
		.filter((entry) => entry.data.published === true)
		.map((entry) => ({
			params: { slug: entry.data.slug },
			props: { entry },
		}));
}

interface Props {
	entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<article class="article">
		<header class="article-header">
			<p class="eyebrow">Writing</p>
			<h1>{entry.data.title}</h1>
			<p class="article-header__summary">{entry.data.description}</p>
			<div class="article-header__meta">
				<time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated)}</time>
				<span>{readingTime(entry.body)} min read</span>
			</div>
		</header>
		<div class:list={{ 'article-layout': headings.length > 0 }}>
			{
				headings.length > 0 && (
					<aside class="table-of-contents" aria-label="On this page">
						<p>On this page</p>
						<ol>
							{headings.filter((heading) => heading.depth <= 2).map((heading) => (
								<li><a href={'#' + heading.slug}>{heading.text}</a></li>
							))}
						</ol>
					</aside>
				)
			}
			<div class="prose"><Content /></div>
		</div>
	</article>
</BaseLayout>
