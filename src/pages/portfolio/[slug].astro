---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/site';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects
		.filter((entry) => entry.data.published === true)
		.map((entry) => ({
			params: { slug: entry.data.slug },
			props: { entry },
		}));
}

interface Props {
	entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<article class="article">
		<header class="article-header">
			<p class="eyebrow">Portfolio</p>
			<h1>{entry.data.title}</h1>
			<p class="article-header__summary">{entry.data.description}</p>
			<div class="article-header__meta">
				<time datetime={entry.data.updated.toISOString()}>Updated {formatDate(entry.data.updated)}</time>
				{
					entry.data.topics.length > 0 && (
						<ul class="topic-list" aria-label="Topics">
							{entry.data.topics.map((topic) => <li>{topic}</li>)}
						</ul>
					)
				}
			</div>
		</header>
		<div class:list={{ 'article-layout': headings.length > 0 }}>
			{
				headings.length > 0 && (
					<aside class="table-of-contents" aria-label="On this page">
						<p>On this page</p>
						<ol>
							{headings.filter((heading) => heading.depth <= 2).map((heading) => (
								<li><a href={'#' + heading.slug}>{heading.text}</a></li>
							))}
						</ol>
					</aside>
				)
			}
			<div class="prose"><Content /></div>
		</div>
	</article>
</BaseLayout>
